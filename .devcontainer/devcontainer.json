{
    "name": "kekspuh",
    "build": {
        "dockerfile": "dockerfile"
    },
    "workspaceFolder": "/workspaces/kekspuh",
    "workspaceMount": "source=//wsl.localhost/devbuntu/home/devbuntu/_dev/kekspuh,target=/workspaces/kekspuh,type=bind",
    "runArgs": [
        "--hostname=kekspuh"
    ],
    "features": {
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
    },
    "forwardPorts": [
        8888
    ],
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "containerEnv": {
        "PIP_REQUIRE_VIRTUALENV": "true",
        "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv",
        "SHELL": "/bin/zsh"
    },
    "customizations": {
        "jetbrains": {
            "backend": "PyCharm",
            "plugins": [
                "com.koxudxh.ruff"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh"
}