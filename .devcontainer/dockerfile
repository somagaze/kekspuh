FROM mcr.microsoft.com/devcontainers/python:3.14-trixie

RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get install -y --no-install-recommends \
        cowsay \
        fortune-mod \
        libsqlite3-dev \
        shfmt \
        sqlite3 \
        stow \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
